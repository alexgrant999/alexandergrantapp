generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Client {
  id               String   @id @default(cuid())
  name             String
  email            String   @unique
  company          String?
  phone            String?
  address          String?
  notes            String?
  portalToken      String   @unique @default(cuid())
  stripeCustomerId String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  projects      Project[]
  invoices      Invoice[]
  subscriptions Subscription[]
}

model Project {
  id          String        @id @default(cuid())
  clientId    String
  name        String
  description String?
  repoName    String?       @unique
  status      ProjectStatus @default(ACTIVE)
  budget      Decimal?      @db.Decimal(10, 2)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  client        Client         @relation(fields: [clientId], references: [id])
  timeEntries   TimeEntry[]
  expenses      Expense[]
  invoices      Invoice[]
  subscriptions Subscription[]
  workLogs      WorkLog[]
}

model WorkLog {
  id         String   @id @default(cuid())
  projectId  String
  commitHash String   @unique
  message    String
  date       DateTime
  billed     Boolean  @default(false)
  createdAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

model Invoice {
  id              String        @id @default(cuid())
  clientId        String
  projectId       String?
  number          String        @unique
  status          InvoiceStatus @default(DRAFT)
  issueDate       DateTime      @default(now())
  dueDate         DateTime
  subtotal        Decimal       @db.Decimal(10, 2)
  tax             Decimal       @default(0) @db.Decimal(10, 2)
  total           Decimal       @db.Decimal(10, 2)
  notes           String?
  stripeSessionId String?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  client  Client        @relation(fields: [clientId], references: [id])
  project Project?      @relation(fields: [projectId], references: [id])
  items   InvoiceItem[]
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Decimal @db.Decimal(10, 2)
  rate        Decimal @db.Decimal(10, 2)
  amount      Decimal @db.Decimal(10, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                      String             @id @default(cuid())
  clientId                String
  projectId               String?
  name                    String
  amount                  Decimal            @db.Decimal(10, 2)
  interval                BillingInterval
  status                  SubscriptionStatus @default(PENDING)
  stripeSubscriptionId    String?            @unique
  stripeCheckoutSessionId String?            @unique
  stripeCheckoutUrl       String?
  stripeCustomerId        String?
  currentPeriodStart      DateTime?
  currentPeriodEnd        DateTime?
  cancelAtPeriodEnd       Boolean            @default(false)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  client  Client   @relation(fields: [clientId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])
}

enum BillingInterval {
  MONTHLY
  QUARTERLY
  ANNUALLY
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAUSED
  CANCELLED
  PAST_DUE
}

model TimeEntry {
  id          String   @id @default(cuid())
  projectId   String
  date        DateTime
  hours       Decimal  @db.Decimal(5, 2)
  description String
  billable    Boolean  @default(true)
  hourlyRate  Decimal? @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])
}

model Expense {
  id          String          @id @default(cuid())
  projectId   String
  date        DateTime
  amount      Decimal         @db.Decimal(10, 2)
  description String
  category    ExpenseCategory
  receiptUrl  String?
  billable    Boolean         @default(true)
  createdAt   DateTime        @default(now())

  project Project @relation(fields: [projectId], references: [id])
}

enum ExpenseCategory {
  SOFTWARE
  HARDWARE
  TRAVEL
  HOSTING
  DESIGN
  MARKETING
  OTHER
}

model Resource {
  id          String   @id @default(cuid())
  url         String   @unique
  title       String
  description String?
  image       String?
  submittedBy String?
  tags        String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Rsvp {
  id        String   @id @default(cuid())
  name      String
  attending Boolean
  plusOne   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Proof of consent for the SMS program. Carriers can ask for this, so the exact
/// wording the person agreed to is stored alongside the number rather than being
/// inferred from whatever the page says today.
model SmsOptIn {
  id          String    @id @default(cuid())
  phone       String    @unique
  name        String?
  source      String    @default("web")
  consentText String
  userAgent   String?
  ipHash      String?
  optedOutAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([createdAt])
}

model VoiceCall {
  id             String    @id @default(cuid())
  conversationId String?   @unique
  agentId        String?

  callerNumber String?
  callerName   String?
  business     String?
  interest     String?
  timeline     String?
  budget       String?

  summary       String?
  transcript    Json?
  durationSecs  Int?
  outcome       String?
  portfolioSent Boolean   @default(false)
  startedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([callerNumber])
}

enum CallBookingStatus {
  BOOKED
  CANCELLED
  COMPLETED
  NO_SHOW
}

/// Alex's weekly hours for intro calls. startTime and endTime are "HH:mm" wall
/// clock in `timezone`, so a window keeps its local time through clock changes.
model AvailabilityRule {
  id        String   @id @default(cuid())
  dayOfWeek Int
  startTime String
  endTime   String
  timezone  String
  createdAt DateTime @default(now())
}

model TimeOff {
  id        String   @id @default(cuid())
  startsAt  DateTime @db.Timestamptz(3)
  endsAt    DateTime @db.Timestamptz(3)
  note      String?
  createdAt DateTime @default(now())
}

/// A 15 minute intro call booked from /book. Not linked to Client: a visitor is
/// not a client until Alex makes them one. A reschedule cancels this row and
/// creates a new one whose rescheduledFromId points back here; the unique
/// constraint means two racing reschedules of one booking cannot both land.
model CallBooking {
  id                String            @id @default(cuid())
  startsAt          DateTime          @db.Timestamptz(3)
  endsAt            DateTime          @db.Timestamptz(3)
  status            CallBookingStatus @default(BOOKED)
  name              String
  email             String
  business          String
  need              String
  timezone          String
  meetingUrl        String?
  source            String?
  /// Ad click ids and UTM tags from the booking form (gclid, utm_source, ...); null when there were none.
  attribution       Json?
  ipHash            String?
  rescheduledFromId String?           @unique
  cancelledAt       DateTime?
  /// Set by the Google Calendar sync once it lands; null until then.
  googleEventId     String?
  /// E.164 mobile number, kept only when the visitor asked for a text reminder.
  phone             String?
  smsConsentAt      DateTime?
  /// Ids of the reminders queued with Resend and Twilio, so a cancel or a move can call them back.
  reminderEmailIds  String[]          @default([])
  reminderSmsSid    String?
  createdAt         DateTime          @default(now())

  @@index([status, startsAt])
}

/// A "find a time that works" poll for a group (the Claude meetup and the like).
/// Alex offers candidate times from the dashboard and shares /meet/<slug>; anyone
/// with the link marks the times they can make. Times are instants, so every
/// visitor sees them on their own clock. `timezone` is only the zone Alex set
/// them in, used to show them back to him.
model GroupPoll {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  note            String?
  durationMinutes Int       @default(60)
  timezone        String
  meetingUrl      String?
  /// The option Alex settled on. Set means the poll is decided and the page shows the time.
  chosenOptionId  String?
  closedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  options   GroupPollOption[]
  responses GroupPollResponse[]
}

model GroupPollOption {
  id       String    @id @default(cuid())
  pollId   String
  startsAt DateTime  @db.Timestamptz(3)
  endsAt   DateTime  @db.Timestamptz(3)

  poll GroupPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@unique([pollId, startsAt])
}

/// One person's answers. `yes` and `maybe` hold option ids; any option in neither is a no.
/// No sign in: the browser keeps `editToken` in a cookie so the same person can come back and change them.
model GroupPollResponse {
  id        String   @id @default(cuid())
  pollId    String
  name      String
  timezone  String?
  yes       String[] @default([])
  maybe     String[] @default([])
  editToken String   @unique
  ipHash    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  poll GroupPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@index([pollId])
}
